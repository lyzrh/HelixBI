# 复制为 .env 并填写
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
# 任何 OpenAI 兼容接口均可，例如 DeepSeek / 智谱 / 通义 / 本地 vLLM
MODEL_NAME=gpt-4o-mini

# 认证：JWT 签名密钥
# 未设置时进程内随机生成（仅适合本机单进程开发，重启后登录态失效）；
# 多进程 / 生产部署必须显式配置为随机长字符串，且不要提交进仓库
HELIX_JWT_SECRET=

# 安全（Security Hardening V1）
# 运行环境：development（默认） / production。生产环境对缺失密钥的提示更严格、不做宽松降级。
HELIX_ENV=development

# 数据源凭据加密主密钥（保存数据库连接口令时使用）。
# 未配置时**拒绝保存口令**并提示（不会静默写明文）；配置后启动会自动把历史明文口令迁成密文。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
HELIX_SECRET_KEY=

# Token 生命周期：access 短期有效（秒，默认 1h）；refresh 可撤销（秒，默认 30 天）
HELIX_ACCESS_TOKEN_TTL=3600
HELIX_REFRESH_TOKEN_TTL=2592000

# 沙箱
SANDBOX_IMAGE=helix-sandbox:latest
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
CODE_TIMEOUT_SECONDS=120
MAX_FIX_ATTEMPTS=3

# 成本 / 延迟（Cost & Latency Optimization V1）
# 预算：0 或留空 = 不限制。预检在调用之前，超限的请求不会发出。
# 默认值是「宽松上限」，只拦病态循环（正常分析含 3 次修复都不会触顶）。
MAX_LLM_CALLS_PER_RUN=8
MAX_INPUT_TOKENS_PER_RUN=40000
MAX_OUTPUT_TOKENS_PER_RUN=12000
MAX_TOTAL_TOKENS_PER_RUN=60000
# 成本上限只在配置了 LLM_PRICE_* 单价后才可判定（否则按不限制处理）
MAX_RUN_COST_USD=
# 运行级修复额度上限（0 = 跟随 MAX_FIX_ATTEMPTS；只会更小，不会放大）
MAX_REPAIR_ATTEMPTS=

# 成本优化开关（=v1 / =llm 即回到改造前行为，用于对照与回退）
CONTEXT_POLICY=v2
INTENT_MODE=auto
INTENT_FASTPATH_MIN_CONFIDENCE=0.60
FOLLOWUP_MODE=hybrid
# 上下文裁剪参数（调大即更接近基线）
HISTORY_TURNS=2
HISTORY_ANSWER_CHARS=300
SKILL_FEWSHOT_MAX=1
SKILL_EXAMPLE_MAX_LINES=60
REPAIR_OUTPUT_CHARS=1500
SUMMARIZE_TABLE_ROWS=30
# 数据画像缓存（按文件指纹失效；0 = 每次重新读盘）
PROFILE_CACHE_ENABLED=1

# LLM 计价（用于成本估算与 MAX_RUN_COST_USD；未配置时报告显示「未配置单价」）
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# 元数据库（默认 data/app.db）；测试或临时环境可指向其他路径
# APP_DB_PATH=

# 数据接入
MATERIALIZED_MAX_ROWS=500000
MATERIALIZED_TTL_HOURS=24
MAX_UPLOAD_MB=200

# ---- Production Runtime V1（warm pool / 并发 / 超时取消）----
# 沙箱预热池：0 = 关闭（每次执行 docker run --rm 冷启动）；打开后启动期预热 N 个容器
SANDBOX_POOL_SIZE=2
# 容器用满 N 次强制销毁重建（限制残留数据寿命）
SANDBOX_POOL_MAX_USES=25
# 池满时的等待队列与超时（拿不到 → 自动降级为临时冷容器）
SANDBOX_POOL_QUEUE=8
SANDBOX_ACQUIRE_TIMEOUT=30
SANDBOX_STARTUP_TIMEOUT=60
# 并发控制：全局最多同时执行多少分析 / 单用户上限 / 等待队列容量与超时
MAX_CONCURRENT_RUNS=4
MAX_CONCURRENT_PER_USER=2
RUN_QUEUE_SIZE=16
RUN_QUEUE_TIMEOUT=60
# 整轮运行总时限（秒，0 = 不限制）；Self-Repair 也突破不了它
TOTAL_RUN_TIMEOUT_SECONDS=900
