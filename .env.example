# 复制为 .env 并填写
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
# 任何 OpenAI 兼容接口均可，例如 DeepSeek / 智谱 / 通义 / 本地 vLLM
MODEL_NAME=gpt-4o-mini

# 认证：JWT 签名密钥
# 未设置时进程内随机生成（仅适合本机单进程开发，重启后登录态失效）；
# 多进程 / 生产部署必须显式配置为随机长字符串，且不要提交进仓库
HELIX_JWT_SECRET=

# 沙箱
SANDBOX_IMAGE=helix-sandbox:latest
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
CODE_TIMEOUT_SECONDS=120
MAX_FIX_ATTEMPTS=3

# 元数据库（默认 data/app.db）；测试或临时环境可指向其他路径
# APP_DB_PATH=

# 数据接入
MATERIALIZED_MAX_ROWS=500000
MATERIALIZED_TTL_HOURS=24
MAX_UPLOAD_MB=200
